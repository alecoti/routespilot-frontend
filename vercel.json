{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.routespilot.eu"
        }
      ],
      "destination": "https://routespilot.eu/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "routespilot.it"
        }
      ],
      "destination": "https://routespilot.eu/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.routespilot.it"
        }
      ],
      "destination": "https://routespilot.eu/$1",
      "permanent": true
    }
  ]
}
