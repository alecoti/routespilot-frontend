NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Umami is disabled by default in local development.
NEXT_PUBLIC_UMAMI_ENABLED=false
NEXT_PUBLIC_UMAMI_SCRIPT_URL=http://localhost:3002/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# OpenReplay is disabled by default in local development.
NEXT_PUBLIC_OPENREPLAY_ENABLED=false
NEXT_PUBLIC_OPENREPLAY_PROJECT_KEY=
NEXT_PUBLIC_OPENREPLAY_INGEST_URL=
NEXT_PUBLIC_OPENREPLAY_SAMPLE_RATE=1
NEXT_PUBLIC_OPENREPLAY_ALLOW_LOCALHOST=false
